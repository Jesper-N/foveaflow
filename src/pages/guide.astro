---
import GuidePage from "$lib/components/site/guide-page.svelte";
import { guideMetadata } from "$lib/content/guide";
import { getSiteOrigin } from "$lib/seo/site-url";
import { guideStructuredData } from "$lib/seo/structured-data";

import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout
  title={guideMetadata.title}
  description={guideMetadata.description}
  canonicalPath="/guide/"
  ogType="article"
  structuredData={guideStructuredData(getSiteOrigin(Astro.site))}
>
  <GuidePage client:load />
</BaseLayout>
