---
import AgentTools from "$lib/components/site/agent-tools.astro";
import NoscriptFallback from "$lib/components/site/noscript-fallback.astro";
import TrainerApp from "$lib/components/trainer/trainer-app.svelte";
import { siteMetadata } from "$lib/content/site";
import { getSiteOrigin } from "$lib/seo/site-url";
import { homeStructuredData } from "$lib/seo/structured-data";

import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout
  title={siteMetadata.title}
  description={siteMetadata.description}
  canonicalPath="/"
  ogDescription={siteMetadata.ogDescription}
  twitterDescription={siteMetadata.twitterDescription}
  structuredData={homeStructuredData(getSiteOrigin(Astro.site))}
>
  <AgentTools />
  <TrainerApp client:load />
  <NoscriptFallback
    heading={siteMetadata.name}
    description={siteMetadata.shortDescription}
  />
</BaseLayout>
