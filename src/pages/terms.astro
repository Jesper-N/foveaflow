---
import LegalPage from "$lib/components/site/legal-page.svelte";
import { legalPages } from "$lib/content/legal";
import { getSiteOrigin } from "$lib/seo/site-url";
import { legalStructuredData } from "$lib/seo/structured-data";

import BaseLayout from "../layouts/base-layout.astro";

const page = legalPages.terms;
---

<BaseLayout
  title={page.metaTitle}
  description={page.description}
  canonicalPath={page.path}
  ogType="article"
  structuredData={legalStructuredData(page, getSiteOrigin(Astro.site))}
>
  <LegalPage {page} client:load />
</BaseLayout>
