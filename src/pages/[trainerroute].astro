---
import "../styles/global.css";
import NoscriptFallback from "../lib/components/noscript-fallback.astro";
import SeoHead from "../lib/components/seo-head.astro";
import TrainerApp from "../lib/components/trainer-app.svelte";
import { trainerRoutes } from "../lib/content/trainer-routes";
import type { TrainerRoute } from "../lib/content/trainer-routes";
import { buildTrainerRouteStructuredData, getSiteOrigin } from "../lib/seo";

interface Props {
  route: TrainerRoute;
}

export const getStaticPaths = () =>
  trainerRoutes.map((route) => ({
    params: { trainerroute: route.slug },
    props: { route },
  }));

const { route } = Astro.props;

const siteOrigin = getSiteOrigin(Astro.site);
const robotsContent = route.indexable
  ? "index,follow,max-image-preview:large"
  : "noindex,follow";
const structuredData = route.indexable
  ? buildTrainerRouteStructuredData(route, siteOrigin)
  : undefined;
---

<html lang="en">
  <head>
    <SeoHead
      title={route.title}
      description={route.description}
      canonicalPath={route.path}
      robots={robotsContent}
      {structuredData}
    />
  </head>
  <body>
    <TrainerApp routeSlug={route.slug} client:load />
    <NoscriptFallback
      heading={route.heading}
      description={route.description}
      showHomeLink
    />
  </body>
</html>
