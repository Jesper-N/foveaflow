---
interface Props {
  heading: string;
  description: string;
  showHomeLink?: boolean;
}

const { heading, description, showHomeLink = false } = Astro.props;
---

<noscript>
  <style is:inline>
    .trainer-stage {
      display: none !important;
    }
  </style>
  <main class="noscript-shell">
    <section class="noscript-panel">
      <p class="noscript-kicker">Free online eye trainer</p>
      <h2 class="noscript-title">{heading}</h2>
      <p>{description}</p>
      <p>
        FoveaFlow needs JavaScript to run its moving-target drills. The guide
        and safety information remain available without JavaScript.
      </p>
      <p>
        {showHomeLink && <a href="/">Open the FoveaFlow home page</a>}
        {showHomeLink && " · "}
        <a href="/guide/">Read the FoveaFlow guide</a>
      </p>
    </section>
  </main>
</noscript>

<style>
  .noscript-shell {
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: auto;
    background: var(--background);
    color: var(--foreground);
    padding: 2rem;
  }

  .noscript-panel {
    width: min(100%, 46rem);
    margin: 0 auto;
    line-height: 1.65;
  }

  .noscript-title {
    max-width: 14ch;
    margin: 0;
    font-size: 2.5rem;
    line-height: 0.95;
    letter-spacing: 0;
  }

  .noscript-panel p {
    max-width: 42rem;
    color: var(--muted-foreground);
  }

  .noscript-panel a {
    color: var(--foreground);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .noscript-kicker {
    margin: 0 0 0.75rem;
    color: var(--brand-foreground);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (min-width: 48rem) {
    .noscript-title {
      font-size: 4.5rem;
    }
  }
</style>
