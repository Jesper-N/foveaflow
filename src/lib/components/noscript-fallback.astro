---
interface Props {
  heading: string;
  description: string;
  showHomeLink?: boolean;
}

const { heading, description, showHomeLink = false } = Astro.props;
---

<noscript>
  <style is:inline>
    .trainer-stage {
      display: none !important;
    }
  </style>
  <main
    class="bg-background text-foreground fixed inset-0 z-100 overflow-auto p-8"
  >
    <section
      class="mx-auto w-full max-w-184 leading-[1.65] [&_p]:max-w-2xl [&_p]:text-muted-foreground [&_a]:text-foreground [&_a]:underline [&_a]:underline-offset-[0.2em]"
    >
      <p class="m-0 mb-3 text-sm font-bold uppercase">
        Free online eye trainer
      </p>
      <h2 class="m-0 max-w-[14ch] text-[2.5rem] leading-[0.95] md:text-7xl">
        {heading}
      </h2>
      <p>{description}</p>
      <p>
        FoveaFlow needs JavaScript to run its moving-target drills. The guide
        and safety information remain available without JavaScript.
      </p>
      <p>
        {showHomeLink && <a href="/">Open the FoveaFlow home page</a>}
        {showHomeLink && " · "}
        <a href="/guide/">Read the FoveaFlow guide</a>
      </p>
    </section>
  </main>
</noscript>
