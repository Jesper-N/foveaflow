---
interface Props {
  heading: string;
  description: string;
  /** Drill pages link back to the homepage. */
  showHomeLink?: boolean;
}

const { heading, description, showHomeLink = false } = Astro.props;
---

<!-- The drills need JavaScript. Without it, this replaces the empty trainer. -->
<noscript>
  <style is:inline>
    .trainer-stage {
      display: none !important;
    }
  </style>
  <main>
    <h2>{heading}</h2>
    <p>{description}</p>
    <p>
      FoveaFlow needs JavaScript to run its moving-target drills. The guide
      works without it.
    </p>
    {showHomeLink && <a href="/">Open the FoveaFlow home page</a>}
    <a href="/guide/">Read the FoveaFlow guide</a>
  </main>
</noscript>
