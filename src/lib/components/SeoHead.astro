---
import { createInitialModeExpression } from "mode-watcher";
import { siteMetadata } from "../content/site";
import {
  defaultLocale,
  languageOptions,
  localeAliases,
  localeCookieMaxAge,
  localeCookieName,
  localeLocalStorageKey,
  localePrefixAliases,
} from "../i18n/locales";
import { absoluteUrl, getSiteOrigin } from "../seo";
import ThemeFavicon from "./ThemeFavicon.astro";

type OpenGraphType = "website" | "article";

interface Props {
  title: string;
  description: string;
  canonicalPath: `/${string}`;
  structuredData?: unknown;
  ogType?: OpenGraphType;
  ogDescription?: string;
  twitterDescription?: string;
  robots?: string;
}

const {
  title,
  description,
  canonicalPath,
  structuredData,
  ogType = "website",
  ogDescription = description,
  twitterDescription = ogDescription,
  robots = "index,follow,max-image-preview:large",
} = Astro.props;

const initialModeExpression = createInitialModeExpression({
  defaultMode: "system",
});
const siteOrigin = getSiteOrigin(Astro.site);
const canonicalUrl = absoluteUrl(canonicalPath, siteOrigin);
const ogImageUrl = absoluteUrl(siteMetadata.imagePath, siteOrigin);
const structuredDataJson =
  structuredData === undefined ? "" : JSON.stringify(structuredData);
const i18nBootConfig = {
  cookieMaxAge: localeCookieMaxAge,
  cookieName: localeCookieName,
  defaultLocale,
  localeAliases,
  localePrefixAliases,
  locales: languageOptions.map((option) => option.locale),
  localStorageKey: localeLocalStorageKey,
};
const i18nBootScript = `
(() => {
  const config = ${JSON.stringify(i18nBootConfig)};
  const resolveSupportedLocale = (value) => {
    if (!value) return null;

    const locale = String(value).replace(/_/g, "-");
    if (config.locales.includes(locale)) return locale;

    const lower = locale.toLowerCase();
    if (config.localeAliases[lower]) return config.localeAliases[lower];

    const prefixAlias = config.localePrefixAliases.find(([prefix]) => lower.startsWith(prefix));
    return prefixAlias ? prefixAlias[1] : null;
  };
  const readLocalStorageLocale = () => {
    try {
      return window.localStorage.getItem(config.localStorageKey);
    } catch {
      return null;
    }
  };
  const readCookieLocale = () => {
    const cookiePrefix = config.cookieName + "=";
    const cookie = document.cookie
      .split(";")
      .map((value) => value.trim())
      .find((value) => value.startsWith(cookiePrefix));

    return cookie ? decodeURIComponent(cookie.slice(cookiePrefix.length)) : null;
  };
  const readNavigatorLocale = () => {
    const languages = Array.isArray(navigator.languages) ? navigator.languages : [];
    for (const language of [...languages, navigator.language]) {
      const locale = resolveSupportedLocale(language);
      if (locale) return locale;
    }
    return null;
  };
  const storedLocale = resolveSupportedLocale(readLocalStorageLocale());
  const cookieLocale = resolveSupportedLocale(readCookieLocale());
  const resolvedLocale = storedLocale || cookieLocale || readNavigatorLocale() || config.defaultLocale;

  document.documentElement.lang = resolvedLocale;
  document.documentElement.dir = "ltr";

  if (resolvedLocale !== config.defaultLocale) {
    document.documentElement.dataset.i18nPending = "true";
    window.setTimeout(() => {
      delete document.documentElement.dataset.i18nPending;
    }, 2500);
  }

  if (storedLocale || resolvedLocale !== config.defaultLocale) {
    try {
      document.cookie = config.cookieName + "=" + encodeURIComponent(resolvedLocale) + "; path=/; max-age=" + config.cookieMaxAge;
    } catch {
      // Ignore blocked cookie writes.
    }
  }
})();
`;
---

<meta charset="utf-8" />
<script is:inline set:html={initialModeExpression} />
<script is:inline set:html={i18nBootScript} />
<style is:inline>
  html[data-i18n-pending="true"] body > * {
    visibility: hidden;
  }
</style>
<ThemeFavicon />
<link rel="canonical" href={canonicalUrl} />
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
<link
  rel="alternate"
  type="application/xml"
  href="/sitemap.xml"
  title="Sitemap"
/>
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="date" content={siteMetadata.lastUpdated} />
<meta name="last-modified" content={siteMetadata.lastUpdated} />
<meta name="DC.date.modified" content={siteMetadata.lastUpdated} />
<meta name="application-name" content={siteMetadata.name} />
<meta name="apple-mobile-web-app-title" content={siteMetadata.name} />
<meta name="theme-color" content="#95E217" />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteMetadata.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:updated_time" content={siteMetadata.lastUpdated} />
<meta
  property="og:image:alt"
  content="FoveaFlow canvas with a moving practice target"
/>
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{
  ogType === "article" && (
    <meta property="article:modified_time" content={siteMetadata.lastUpdated} />
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={twitterDescription} />
<meta name="twitter:image" content={ogImageUrl} />
<meta
  name="twitter:image:alt"
  content="FoveaFlow canvas with a moving practice target"
/>
{
  structuredDataJson && (
    <script
      is:inline
      type="application/ld+json"
      set:html={structuredDataJson}
    />
  )
}
<title>{title}</title>
