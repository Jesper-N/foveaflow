{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-04-28",
  "name": "foveaflow",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "redact_query_string": true,
  },
}
