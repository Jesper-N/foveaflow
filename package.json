{
  "name": "foveaflow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && bun run preload:modules",
    "preload:modules": "bun scripts/preload-island-modules.ts",
    "preview": "bun run build && wrangler dev",
    "astro": "astro",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:i18n": "bun scripts/check-translations.ts",
    "test": "bun run test:unit && bun run test:browser",
    "test:unit": "bun test tests/unit",
    "test:browser": "bun run build && playwright test",
    "audit": "bun audit --ignore=GHSA-vfj7-8cjw-p6xm --ignore=GHSA-ch52-4w7c-c8xp --ignore=GHSA-gcqx-w48m-w2h4",
    "verify": "bun run lint && bun run check && bun run check:i18n && bun run tailwind:diagnostics && bun run test && bun run audit",
    "prepare": "git config core.hooksPath .githooks",
    "tailwind:diagnostics": "bun scripts/tailwind-canonical-classes.ts",
    "lint": "ultracite check && eslint --config eslint.svelte.config.ts --max-warnings 0 .",
    "lint:report": "bun scripts/lint-report.ts",
    "format": "oxfmt --write .",
    "deploy": "bun run verify && wrangler deploy",
    "fix": "eslint --config eslint.svelte.config.ts --fix . && ultracite fix"
  },
  "dependencies": {
    "@astrojs/svelte": "9.1.6",
    "@lucide/svelte": "^1.77.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.13",
    "mode-watcher": "1.1.0",
    "svelte": "5.58.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler-rs": "0.5.3",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.4.5",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "enhanced-resolve": "5.27.0",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "ultracite": "8.3.1",
    "wrangler": "4.165.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "fast-uri": "3.1.9",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "svgo": "4.1.0",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "packageManager": "bun@1.4.5"
}
