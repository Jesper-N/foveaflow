{
  "name": "foveaflow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && bun run csp:headers",
    "csp:headers": "bun scripts/apply-csp.ts",
    "preview": "bun run build && wrangler dev",
    "astro": "astro",
    "check": "astro check",
    "check:tools": "tsc --noEmit -p tsconfig.tools.json",
    "check:i18n": "bun scripts/check-translations.ts",
    "test": "bun run test:unit && bun run test:browser",
    "test:unit": "bun test tests/unit",
    "test:browser": "bun run build && playwright test",
    "audit": "bun audit --ignore=GHSA-vfj7-8cjw-p6xm --ignore=GHSA-ch52-4w7c-c8xp",
    "verify": "bun run format:check && bun run check && bun run check:tools && bun run check:i18n && bun run tailwind:diagnostics && bun run test && bun run audit",
    "prepare": "git config core.hooksPath .githooks",
    "tailwind:diagnostics": "bun scripts/tailwind-canonical-classes.ts",
    "lint": "ultracite check",
    "lint:report": "bun scripts/lint-report.ts",
    "format": "oxfmt --write . && bun run format:astro",
    "format:check": "bun run lint && bun run format:astro:check",
    "format:astro": "prettier --write --plugin=prettier-plugin-astro \"src/**/*.astro\"",
    "format:astro:check": "prettier --check --plugin=prettier-plugin-astro \"src/**/*.astro\"",
    "deploy": "bun run verify && wrangler deploy",
    "fix": "ultracite fix && bun run format:astro"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "^1.41.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.1",
    "bits-ui": "2.19.0",
    "clsx": "^2.1.1",
    "mode-watcher": "1.1.0",
    "svelte": "5.57.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.1",
    "enhanced-resolve": "5.24.5",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "shadcn-svelte": "^1.6.1",
    "typescript": "6.0.3",
    "ultracite": "7.12.2",
    "wrangler": "4.144.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "fast-uri": "3.1.8",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "smol-toml": "1.9.0",
    "source-map-js": "1.2.2",
    "svgo": "4.1.0",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.1"
}
