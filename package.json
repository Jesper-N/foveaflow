{
  "name": "foveaflow",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && bun run csp:headers",
    "csp:headers": "bun scripts/apply-csp.ts",
    "preview": "bun run build && wrangler dev",
    "astro": "astro",
    "check": "astro check",
    "check:tools": "tsc --noEmit -p tsconfig.tools.json",
    "test": "bun run test:unit && bun run test:smoke",
    "test:unit": "bun test tests/engine",
    "test:smoke": "bun run build && playwright test",
    "audit": "bun audit",
    "verify": "bun run lint && bun run format:astro:check && bun run check && bun run check:tools && bun run tailwind:diagnostics && bun run test && bun run audit",
    "prepush": "bun run verify",
    "tailwind:diagnostics": "bun scripts/tailwind-canonical-classes.ts",
    "lint": "ultracite check",
    "lint:report": "scripts/lint-report.sh",
    "format": "oxfmt --write . && bun run format:astro",
    "format:check": "bun run lint && bun run format:astro:check",
    "format:astro": "prettier --write --plugin=prettier-plugin-astro \"src/**/*.astro\"",
    "format:astro:check": "prettier --check --plugin=prettier-plugin-astro \"src/**/*.astro\"",
    "deploy": "bun run verify && wrangler deploy",
    "fix": "ultracite fix && bun run format:astro"
  },
  "dependencies": {
    "@astrojs/svelte": "9.0.1",
    "@internationalized/date": "3.12.3",
    "@lucide/svelte": "1.31.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.2",
    "bits-ui": "2.18.1",
    "clsx": "2.1.1",
    "mode-watcher": "1.1.0",
    "svelte": "5.56.9",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "enhanced-resolve": "5.24.5",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "shadcn-svelte": "1.5.0",
    "typescript": "6.0.3",
    "ultracite": "7.10.7",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.3",
    "svgo": "4.0.2",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}
